# Cal.com self-hosted — contrato completo de entorno
# Copiar a Coolify Environment Variables, NUNCA commitear .env real.
#
# Coolify v3 quoting bug: si algún value contiene < > o espacios,
# envuélvelo con ' (memoria reference_coolify_env_quoting).

# Base de datos. Sustituir el marcador por el mismo POSTGRES_PASSWORD.
POSTGRES_USER=calcom
POSTGRES_PASSWORD=<generar_con_openssl_rand_hex_24>
POSTGRES_DB=calcom
DATABASE_URL=postgresql://calcom:<POSTGRES_PASSWORD>@cal-db:5432/calcom
DATABASE_DIRECT_URL=postgresql://calcom:<POSTGRES_PASSWORD>@cal-db:5432/calcom

# URLs públicas
NEXTAUTH_URL=https://cal.hubstartidea.es
NEXT_PUBLIC_WEBAPP_URL=https://cal.hubstartidea.es
NEXT_PUBLIC_API_V2_URL=https://cal.hubstartidea.es/api/v2

# Generado con `openssl rand -hex 32`
NEXTAUTH_SECRET=<generar>

# Generado con `openssl rand -hex 16` (DEBE ser exactamente 32 chars)
CALENDSO_ENCRYPTION_KEY=<generar>

# Email SMTP mediante Resend. La contraseña es una API key de Resend, pero
# Cal.com consume EMAIL_SERVER_PASSWORD, no RESEND_API_KEY.
EMAIL_FROM=<remitente_verificado_en_Resend>
EMAIL_FROM_NAME=Startidea
EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=resend
EMAIL_SERVER_PASSWORD=re_<copiar_del_gestor_de_secretos>

# Runtime
NODE_ENV=production
CALCOM_TELEMETRY_DISABLED=1
NEXT_PUBLIC_LICENSE_CONSENT=agree
