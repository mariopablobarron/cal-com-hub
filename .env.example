# Cal.com self-hosted — variables sensibles
# Copiar a Coolify Environment Variables, NUNCA commitear .env real.
#
# Coolify v3 quoting bug: si algún value contiene < > o espacios,
# envuélvelo con ' (memoria reference_coolify_env_quoting).

# Generados con `openssl rand -hex 32`
NEXTAUTH_SECRET=<generar>

# Generados con `openssl rand -hex 16` (DEBE ser exactamente 32 chars)
CALENDSO_ENCRYPTION_KEY=<generar>

# Generados con `openssl rand -hex 24`
POSTGRES_PASSWORD=<generar>

# Resend API key — la misma que usa hub-startidea-web (re:hello@...)
RESEND_API_KEY=re_<copiar_del_hub>
